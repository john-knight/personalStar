page {
  background: #F7F8FA;
  color: #1F2329;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

.muted {
  color: #8A9099;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 32rpx;
}

.divider {
  height: 1rpx;
  background: #EEEFF1;
  margin: 24rpx 0;
}

.btn-primary {
  background: #F0658A;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
}

.btn-ghost {
  background: #FFFFFF;
  color: #1F2329;
  border: 1rpx solid #E3E5E8;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
}

.btn-primary.disabled {
  background: #F5C6D2;
}
