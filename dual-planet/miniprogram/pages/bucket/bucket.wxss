.head {
  margin-bottom: 16rpx;
}

.big {
  font-size: 64rpx;
  font-weight: 700;
  color: #F0658A;
}

.bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #F0F1F3;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.bar-in {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #F0658A, #A9B8F5);
  transition: width 0.3s;
}

.group-count {
  margin-left: 12rpx;
}

.bk {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}

.bk:last-child {
  border-bottom: none;
}

.box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #D8DCE1;
  margin: 2rpx 20rpx 0 0;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 36rpx;
}

.bk.on .box {
  background: #F0658A;
  border-color: #F0658A;
}

.bk-body {
  flex: 1;
}

.bk-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: #2A2E33;
}

.bk.on .bk-text {
  color: #A6ACB3;
  text-decoration: line-through;
}

/* 自己加一件 */
.add-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  font-size: 26rpx;
}

.add-btn {
  width: 130rpx;
  margin-left: 14rpx;
}

.bk-del {
  width: 56rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 34rpx;
  color: #C9CDD2;
  line-height: 1.2;
}
