.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.who {
  font-size: 30rpx;
  font-weight: 600;
}

.timer {
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  background: #F7F8FA;
  font-size: 26rpx;
  color: #6B7075;
}

.timer.urgent {
  background: #FFF1F5;
  color: #F0658A;
}

.grid {
  position: relative;
  margin: 0 auto;
  border-radius: 20rpx;
  overflow: hidden;
  background: #FBF7F8;
}

.cell {
  position: absolute;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(240, 101, 138, 0.12);
  transition: background 120ms ease-out;
}

.cell.on {
  background: #FFF1F5;
}

.cell.hit {
  background: #F0658A;
}

.cell.miss {
  background: #F3F4F6;
}

.heart {
  font-size: 56rpx;
  animation: pop 300ms ease-out;
}

@keyframes pop {
  0% { transform: scale(0.5); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}

.side {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
}

.side.cur {
  background: #FFF1F5;
}

.side-name {
  font-size: 24rpx;
  color: #8A9099;
}

.side-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #F0658A;
  line-height: 1.2;
}

.vs {
  padding: 0 20rpx;
  color: #C9CDD2;
}

.center {
  text-align: center;
}

.hint {
  font-size: 26rpx;
  color: #6B7075;
  margin-bottom: 28rpx;
}

.center .btn-primary,
.center .btn-ghost {
  margin-top: 16rpx;
}

.over-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.reward {
  font-size: 30rpx;
  color: #F0658A;
  margin: 16rpx 0 8rpx;
}
