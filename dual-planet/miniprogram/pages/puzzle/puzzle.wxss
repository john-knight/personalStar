.head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.stat-pill {
  margin-right: 16rpx;
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  background: #F7F8FA;
  font-size: 24rpx;
  color: #6B7075;
}

.done-pill {
  background: #FFF1F5;
  color: #F0658A;
}

/* 选图 */
.pick {
  text-align: center;
  padding: 60rpx 0;
}

.pick-icon {
  font-size: 80rpx;
}

.pick-title {
  font-size: 32rpx;
  margin-top: 16rpx;
}

.pick-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

/* 棋盘 */
.board {
  position: relative;
  margin: 0 auto;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F0F1F3;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.08);
}

.cell-img {
  position: absolute;
  pointer-events: none;
}

/* 透明的点击层压在图片上面 */
.cell {
  position: absolute;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  z-index: 4;
}

.cell.sel {
  border: 4rpx solid #F0658A;
  background: rgba(255, 255, 255, 0.25);
}

.cell.fit {
  border-color: rgba(255, 255, 255, 0.9);
}

.peek {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center;
  z-index: 8;
}

/* 操作 */
.ops {
  display: flex;
  margin-top: 28rpx;
}

.ops .btn-ghost {
  flex: 1;
  margin-right: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.ops .btn-ghost:last-child {
  margin-right: 0;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  margin-top: 20rpx;
}

/* 结果 */
.result {
  text-align: center;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.reward {
  font-size: 30rpx;
  color: #F0658A;
  margin: 16rpx 0 28rpx;
}
